# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=replace_with_permanent_or_temporary_access_token
PHONE_NUMBER_ID=replace_with_phone_number_id
GRAPH_API_VERSION=v23.0
APP_SECRET=replace_with_meta_app_secret
VERIFY_TOKEN=choose_a_long_random_webhook_verification_token

# Server
PORT=3000
LOG_LEVEL=info

# Processing limits (bytes; WhatsApp video messages are commonly limited to 16 MB)
MAX_INPUT_BYTES=16777216
MAX_OUTPUT_BYTES=16777216
MAX_VIDEO_SECONDS=300
FFMPEG_TIMEOUT_MS=180000
VIDEO_MAX_WIDTH=1280
VIDEO_CRF=28
VIDEO_MAXRATE=1800k
VIDEO_AUDIO_BITRATE=96k
