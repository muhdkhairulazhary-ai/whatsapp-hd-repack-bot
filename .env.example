# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=replace_with_permanent_or_temporary_access_token
PHONE_NUMBER_ID=replace_with_phone_number_id
GRAPH_API_VERSION=v23.0
APP_SECRET=replace_with_meta_app_secret
VERIFY_TOKEN=choose_a_long_random_webhook_verification_token

# Server
PORT=3000
LOG_LEVEL=info

# Processing limits (bytes; WhatsApp video messages are commonly limited to 16 MB)
MAX_INPUT_BYTES=16777216
MAX_OUTPUT_BYTES=16777216
MAX_VIDEO_SECONDS=300
FFMPEG_TIMEOUT_MS=600000
VIDEO_MAX_WIDTH=1280
VIDEO_CRF=28
VIDEO_MAXRATE=1800k
VIDEO_AUDIO_BITRATE=96k

# WhatsApp Linked Devices transport (Baileys)
BOT_NAME=Shelby+
BOT_FULL_NAME="Shelby+ HD Status Bot"
BOT_TAGLINE="Your Status. Your Quality."
BOT_PREFIX=.
BOT_ACCOUNTS_DIR=./shelby-accounts
BOT_MEDIA_CONCURRENCY=1
BOT_MEDIA_QUEUE_SIZE=4
BOT_MEDIA_JOB_TIMEOUT_MS=900000
BAILEYS_MAX_INPUT_BYTES=150000000
BAILEYS_MAX_OUTPUT_BYTES=150000000

# Optional encrypted WhatsApp auth storage (Upstash Redis REST)
# BAILEYS_AUTH_REDIS_URL=https://your-database.upstash.io
# BAILEYS_AUTH_REDIS_TOKEN=your-read-write-rest-token
# BAILEYS_AUTH_ENCRYPTION_KEY=base64-encoded-32-random-bytes
# BAILEYS_AUTH_SESSION_ID=shelby
# BAILEYS_AUTH_MIGRATE_LOCAL=0
